{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarespejel/uc/docs/agent/schemas/native-support-report.schema.json",
  "title": "uc NativeSupportReport",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "manifest_path",
    "status",
    "decision_status",
    "supported",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "status": { "enum": ["supported", "unsupported", "unavailable"] },
    "decision_status": {
      "enum": [
        "native_supported",
        "native_unsupported",
        "fallback_likely",
        "build_blocked"
      ]
    },
    "supported": { "type": "boolean" },
    "reason": { "type": "string" },
    "compiler_version": { "type": "string" },
    "package_cairo_version": { "type": "string" },
    "issue_kind": { "type": "string" },
    "toolchain": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "edition": { "type": "string" },
        "requested_version": { "type": "string" },
        "requested_major_minor": { "type": "string" },
        "source": { "enum": ["builtin", "external_helper"] },
        "binary_path": { "type": "string" },
        "compiler_version": { "type": "string" },
        "host_ready": {
          "type": "boolean",
          "description": "Whether this toolchain can run on this host now. `supported` describes the project's shape; `host_ready` describes the machine. A shape-supported external-helper lane whose helper was never built reports supported=true with host_ready=false, and the build would downgrade to scarb. Run `uc toolchain ensure` first."
        },
        "helper_built": {
          "type": "boolean",
          "description": "External-helper lanes only: whether the helper binary exists and is executable. Absent for the builtin lane."
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "native-diagnostic.schema.json" }
    }
  }
}
